# Valve Mobile App - Environment Configuration
# Copy this file to .env and fill in the values

# === Firebase ===
# Firebase project credentials (required for auth and firestore)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_NUMBER=your-project-number
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-firebase-app-id

# === Server ===
# Backend API base URL
API_BASE_URL=http://localhost:3000

# === ThingsBoard ===
# ThingsBoard Cloud instance credentials
THINGSBOARD_TENANT=your-tenant
THINGSBOARD_API_KEY=your-api-key

# === Razorpay ===
# Razorpay payment gateway keys
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# === Admin ===
# Admin secret key (for server-side admin operations)
ADMIN_SECRET=change-this-to-a-secure-random-value

# === App ===
# Application configuration
APP_NAME=Valve Mobile
APP_ENV=development
APP_URL=http://localhost:19006

# === WebSocket ===
WS_URL=ws://localhost:3000/ws

# === Logging ===
NODE_LOG_LEVEL=debug