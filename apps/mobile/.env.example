# Valve mobile — PUBLIC configuration only.
# Copy to .env (never commit .env). Values here are embedded in the app bundle.
# Never place Firebase Admin keys, ThingsBoard API keys, Razorpay secrets or
# webhook secrets in this file.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Public HTTPS URL of the Fastify backend (Cloud Run), no trailing slash.
# For a physical phone, localhost does not work: use your LAN IP or tunnel.
EXPO_PUBLIC_BACKEND_URL=

# Razorpay public Key ID (rzp_test_... in Test Mode). NOT the Key Secret.
EXPO_PUBLIC_RAZORPAY_KEY_ID=
